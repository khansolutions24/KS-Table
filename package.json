  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false --tsconfig tsconfig.node.json src/devserver/server.ts\" \"vite --config vite.web.config.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "iconv-lite": "^0.7.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.9",
    "papaparse": "^5.7.0",
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@radix-ui/react-context-menu": "^2.3.7",
