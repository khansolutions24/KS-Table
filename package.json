    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
